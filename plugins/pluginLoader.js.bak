const fs = require('fs');
const path = require('path');
const { downloadContentFromMessage } = require('@whiskeysockets/baileys');

class PluginLoader {
    constructor() {
        this.commands = new Map();
        this.categories = new Map();
        this.loadAllPlugins();
    }

    loadAllPlugins() {
        const pluginsDir = __dirname;
        const categories = fs.readdirSync(pluginsDir);

        categories.forEach(category => {
            const categoryPath = path.join(pluginsDir, category);
            
            if (fs.statSync(categoryPath).isDirectory()) {
                const pluginFiles = fs.readdirSync(categoryPath)
                    .filter(file => file.endsWith('.js') && file !== 'index.js');

                this.categories.set(category, []);

                pluginFiles.forEach(pluginFile => {
                    try {
                        const pluginPath = path.join(categoryPath, pluginFile);
                        const plugin = require(pluginPath);
                        
                        if (plugin.name && plugin.execute) {
                            this.commands.set(plugin.name, {
                                ...plugin,
                                category: category,
                                file: pluginFile
                            });
                            
                            this.categories.get(category).push(plugin.name);
                            
                            // Aliases bhi add karo
                            if (plugin.aliases) {
                                plugin.aliases.forEach(alias => {
                                    this.commands.set(alias, {
                                        ...plugin,
                                        category: category,
                                        file: pluginFile,
                                        isAlias: true
                                    });
                                });
                            }
                            
                            console.log(`✅ Loaded plugin: ${category}/${plugin.name}`);
                        } else {
                            console.log(`❌ Invalid plugin: ${category}/${pluginFile}`);
                        }
                    } catch (error) {
                        console.error(`❌ Error loading ${category}/${pluginFile}:`, error.message);
                    }
                });
            }
        });
        
        console.log(`\n🎯 Total plugins loaded: ${this.commands.size}`);
        console.log(`📁 Categories: ${Array.from(this.categories.keys()).join(', ')}`);
    }

    getCommand(commandName) {
        return this.commands.get(commandName);
    }

    getCommandsByCategory(category) {
        return this.categories.get(category) || [];
    }

    getAllCommands() {
        return Array.from(this.commands.entries())
            .filter(([name, cmd]) => !cmd.isAlias)
            .map(([name, cmd]) => ({
                name: cmd.name,
                category: cmd.category,
                description: cmd.description || 'No description',
                aliases: cmd.aliases || []
            }));
    }

    // ✅ NEW: Context creation method for backward compatibility
    createPluginContext(socket, msg, args, from, sender, number, config, q, text, ai, m) {
        const botNumber = socket.user.id.split(':')[0];
        const senderNumber = sender.split('@')[0];
        const developers = `${config.OWNER_NUMBER}`;
        const isbot = botNumber.includes(senderNumber);
        const isOwner = isbot ? isbot : developers.includes(senderNumber);
        const isGroup = from.endsWith('@g.us');

        return {
            // ✅ Original parameters (backward compatibility)
            socket, msg, args, from,
            
            // ✅ All additional parameters
            sender, number, config, q, text, ai, m,
            
            // ✅ Utility functions
            reply: async (message, options = {}) => {
                return await socket.sendMessage(from, { 
                    text: message,
                    contextInfo: {
                        mentionedJid: [sender],
                        forwardingScore: 999,
                        isForwarded: true,
                        forwardedNewsletterMessageInfo: {
                            newsletterJid: '120363403380688821@newsletter',
                            newsletterName: "ADEEL-MINI", 
                            serverMessageId: 143
                        }
                    }
                }, { quoted: ai, ...options });
            },
            
            react: async (emoji) => {
                return await socket.sendMessage(from, { 
                    react: { text: emoji, key: msg.key } 
                });
            },
            
            sendMessage: async (content, options = {}) => {
                return await socket.sendMessage(from, content, { quoted: msg, ...options });
            },
            
            // ✅ Media utilities
            downloadMedia: async (mediaMessage, messageType) => {
                try {
                    const stream = await downloadContentFromMessage(mediaMessage, messageType);
                    const chunks = [];
                    for await (const chunk of stream) chunks.push(chunk);
                    return Buffer.concat(chunks);
                } catch (error) {
                    console.error(`Failed to download ${messageType}:`, error);
                    return null;
                }
            },
            
            downloadAndSaveMediaMessage: async (message, filename, attachExtension = true) => {
                const fs = require('fs-extra');
                let quoted = message.msg ? message.msg : message;
                let mime = (message.msg || message).mimetype || '';
                let messageType = message.mtype ? message.mtype.replace(/Message/gi, '') : mime.split('/')[0];
                const stream = await downloadContentFromMessage(quoted, messageType);
                let buffer = Buffer.from([]);
                for await (const chunk of stream) {
                    buffer = Buffer.concat([buffer, chunk]);
                }
                let type = await require('file-type').fromBuffer(buffer);
                const trueFileName = attachExtension ? (filename + '.' + (type ? type.ext : 'bin')) : filename;
                await fs.writeFileSync(trueFileName, buffer);
                return trueFileName;
            },
            
            // ✅ User info
            isGroup,
            isOwner,
            isBotAdmin: false, // You can add group admin check if needed
            userJid: sender,
            botJid: socket.user.id,
            
            // ✅ Config utilities  
            getUserConfig: async () => {
                const { loadUserConfig } = require('../pair');
                return await loadUserConfig(number.replace(/[^0-9]/g, ''));
            },
            
            updateUserConfig: async (newConfig) => {
                const { updateUserConfig } = require('../pair');
                return await updateUserConfig(number.replace(/[^0-9]/g, ''), newConfig);
            },
            
            // ✅ Other utilities
            delay: (ms) => new Promise(resolve => setTimeout(resolve, ms)),
            getContentType: require('@whiskeysockets/baileys').getContentType,
            formatMessage: (title, content, footer) => {
                return `*${title}*\n\n${content}\n\n> *${footer}*`;
            }
        };
    }
}

module.exports = PluginLoader;